{
  "schemaVersion": 1,
  "id": "hyperfast",
  "version": "${version}",
  "name": "HyperFast",
  "description": "Lightweight, compatibility-first client optimizer. Complements Sodium, Lithium, FerriteCore, ModernFix, ImmediatelyFast and EntityCulling instead of replacing them.",
  "authors": ["Ahmad"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["com.ahmad.hyperfast.HyperFastClient"],
    "modmenu": ["com.ahmad.hyperfast.HyperFastModMenu"]
  },
  "suggests": {
    "modmenu": "*"
  },
  "mixins": ["hyperfast.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "~26.2",
    "java": ">=25"
  }
}
